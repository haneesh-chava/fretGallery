<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Big Frosted Glass Navigation Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_glass_header"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="44dp"
            android:paddingBottom="14dp">

            <!-- Top Row: Logo on Far Left + Horizontal Edge-Scrolling Section Switcher on Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left: fret Brand Logo Container -->
                <FrameLayout
                    android:id="@+id/brandLogoContainer"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_brand_logo_container"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/imgBrandLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="fret brand logo"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_fret_brand_logo" />
                </FrameLayout>

                <!-- Right: Apple Edge-Scrolling Horizontal Section Bar with Liquid Glass Magnification -->
                <HorizontalScrollView
                    android:id="@+id/sectionScrollView"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fadingEdgeLength="28dp"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/sectionContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="12dp">

                        <!-- Camera Tab -->
                        <FrameLayout
                            android:id="@+id/tabCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_liquid_glass_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp">

                            <TextView
                                android:id="@+id/txtTabCamera"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/handjet"
                                android:letterSpacing="0.03"
                                android:text="Camera"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp" />
                        </FrameLayout>

                        <!-- Screenshots Tab -->
                        <FrameLayout
                            android:id="@+id/tabScreenshots"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/txtTabScreenshots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/quicksand"
                                android:text="Screenshots"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <!-- Downloads Tab -->
                        <FrameLayout
                            android:id="@+id/tabDownloads"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/txtTabDownloads"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/quicksand"
                                android:text="Downloads"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <!-- WhatsApp Tab -->
                        <FrameLayout
                            android:id="@+id/tabWhatsapp"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/txtTabWhatsapp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/quicksand"
                                android:text="WhatsApp"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                        </FrameLayout>

                        <!-- Instagram Tab -->
                        <FrameLayout
                            android:id="@+id/tabInstagram"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/txtTabInstagram"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/quicksand"
                                android:text="Instagram"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                        </FrameLayout>

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

            <!-- Subheader: Active Section Title in Handjet Font + Count Statistics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/activeSectionHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/handjet"
                    android:letterSpacing="0.02"
                    android:text="CAMERA VAULT"
                    android:textColor="@color/accent_red_bright"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/headerStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand"
                    android:text="0 Items"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Gallery Grid Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="100dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/bg_glass_card_elevated"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/accent_red_bright" />

                <TextView
                    android:id="@+id/emptyStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/handjet"
                    android:text="No Items in this Section"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/emptyStateSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/quicksand"
                    android:gravity="center"
                    android:text="Capture verified camera photos or seed test media to preview this section."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <!-- Apple Style Capture Button -->
                    <FrameLayout
                        android:id="@+id/btnEmptyCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_apple_button_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/quicksand"
                            android:text="Open Camera"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Apple Style Seed Button -->
                    <FrameLayout
                        android:id="@+id/btnEmptySeed"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_apple_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/quicksand"
                            android:text="Seed Samples"
                            android:textColor="@color/accent_red_bright"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Floating Apple Glass Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_glass_card_elevated"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <!-- Apple Style Seed Button -->
            <FrameLayout
                android:id="@+id/btnSeedDemo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_apple_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/accent_red_bright" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Seed"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Primary Apple Style Camera Pill with Red Radial Gradient -->
            <FrameLayout
                android:id="@+id/btnLaunchCamera"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_apple_button_red"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_camera"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/handjet"
                        android:letterSpacing="0.04"
                        android:text="CAPTURE"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Apple Style Rescan Button -->
            <FrameLayout
                android:id="@+id/btnRefresh"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_apple_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_fingerprint"
                        app:tint="@color/accent_red_bright" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Audit"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
