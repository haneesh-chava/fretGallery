<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid Overlay (Optional) -->
    <FrameLayout
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#40FFFFFF" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#40FFFFFF" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top Frosted Glass Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bg_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnCameraClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_genuine"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_shield_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="fretG PROVENANCE SEAL ACTIVE"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Flash Toggle -->
        <ImageView
            android:id="@+id/btnFlashToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_flash_auto" />

        <!-- Camera Switch -->
        <ImageView
            android:id="@+id/btnCameraSwitch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_camera_flip" />

    </LinearLayout>

    <!-- Optical Sensor HUD -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="110dp"
        android:background="@drawable/bg_glass_card_elevated"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/txtTelemetryLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="4K • 1/120s • ISO 100 • 24mm • SHA-256 MINT READY"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Controls & Shutter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_glass_bottom_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <!-- Zoom Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_glass_pill"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/zoom1x"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_pill_active"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="1x"
                android:textColor="#080B10"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/zoom2x"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="2x"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shutter Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Gallery Shortcut -->
            <ImageView
                android:id="@+id/btnGalleryShortcut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_fingerprint" />

            <!-- Apple iOS Style Shutter Button -->
            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_shutter_outer"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <View
                    android:id="@+id/shutterInner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shutter_inner" />
            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- Processing & Minting HUD Overlay -->
    <FrameLayout
        android:id="@+id/mintingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC080B10"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card_elevated"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/accent_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Minting Birth Certificate..."
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Embedding Steganographic Parity Matrix"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
