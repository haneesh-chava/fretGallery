<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid Overlay -->
    <FrameLayout
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top Frosted Glass Bar with fret Brand Logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bg_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/btnCameraClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_apple_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_liquid_glass_active"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/accent_red_bright" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/handjet"
                    android:letterSpacing="0.04"
                    android:text="fretG PROVENANCE SEAL"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Flash Toggle -->
        <FrameLayout
            android:id="@+id/btnFlashToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_apple_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flash_auto" />
        </FrameLayout>

        <!-- Camera Switch -->
        <FrameLayout
            android:id="@+id/btnCameraSwitch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_apple_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera_flip" />
        </FrameLayout>

    </LinearLayout>

    <!-- Optical Sensor HUD -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="105dp"
        android:background="@drawable/bg_glass_card_elevated"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/txtTelemetryLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand"
            android:text="4K • 1/120s • ISO 100 • 24mm • SHA-256 SEAL READY"
            android:textColor="@color/accent_red_bright"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Controls & Shutter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_glass_bottom_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- Zoom Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_glass_pill"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/zoom1x"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_liquid_glass_active"
                android:fontFamily="@font/handjet"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/zoom2x"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/quicksand"
                android:gravity="center"
                android:text="2x"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Shutter Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Gallery Shortcut -->
            <FrameLayout
                android:id="@+id/btnGalleryShortcut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_apple_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/accent_red_bright" />
            </FrameLayout>

            <!-- Apple Style Shutter Button with Rich Red Radial Accent -->
            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_shutter_outer"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <View
                    android:id="@+id/shutterInner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_apple_button_red" />
            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- Processing & Minting HUD Overlay -->
    <FrameLayout
        android:id="@+id/mintingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E608090E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card_elevated"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/accent_red_bright" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/handjet"
                android:letterSpacing="0.03"
                android:text="MINTING BIRTH CERTIFICATE"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/quicksand"
                android:text="Embedding Steganographic Parity Matrix"
                android:textColor="@color/accent_red_bright"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
